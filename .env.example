APP_ENV=development
DB_DRIVER=sqlsrv
DB_SERVER=localhost,1433
DB_DATABASE=SportZone
DB_USERNAME=sportzone_app
DB_PASSWORD=configure-uma-senha-local
DB_ENCRYPT=yes
DB_TRUST_CERTIFICATE=no
# Somente teste local explícito: DB_DRIVER=sqlite
DB_SQLITE_PATH=storage/sportzone.sqlite
SESSION_SECURE=0

# Pagamentos demonstrativos por solicitação do usuário. A ativação externa está bloqueada no código.
PAYMENT_PROVIDER=simulation
APP_URL=http://localhost:8080
